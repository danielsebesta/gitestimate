# GitHub OAuth App client id — see README "Private repos".
# Optional in dev: you can also pass ?oauth_client_id=… at runtime.
VITE_GITHUB_CLIENT_ID=

# Client secret — NEVER prefix with VITE_ (must not ship in the browser bundle).
# Used by the Vite oauth middleware (dev) and by:
#   npx wrangler secret put GITHUB_CLIENT_SECRET
# on the production Worker for the web authorization-code flow.
GITHUB_CLIENT_SECRET=

# Where OAuth POSTs are proxied (defaults to /api/oauth — Worker or Vite).
# VITE_OAUTH_PROXY=
