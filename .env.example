# GitHub OAuth App client id (Device Flow must be enabled) — see README "Private repos".
# Optional in dev: you can also pass ?oauth_client_id=… at runtime.
VITE_GITHUB_CLIENT_ID=

# Where OAuth POSTs are proxied (GitHub's endpoints send no CORS headers).
# Defaults to /api/oauth, which vite.config.ts proxies in dev.
# In production, point this at your deployed workers/oauth-proxy instance.
VITE_OAUTH_PROXY=
