{
  "name": "gitestimate",
  "private": true,
  "version": "0.1.0",
  "description": "Estimate how much time was spent building a GitHub repository from its commit history.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "deploy": "npm run build && npx wrangler deploy",
    "icons": "node scripts/generate-icons.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "measure": "vite-node scripts/measure.mts",
    "detect-debug": "vite-node scripts/detect-debug.mts"
  },
  "dependencies": {
    "@primer/primitives": "^11.10.0",
    "@primer/react": "^37.6.0",
    "lucide-react": "^1.70.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "styled-components": "^5.3.10"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/styled-components": "^5.1.34",
    "@vitejs/plugin-react": "^4.3.3",
    "png-to-ico": "^3.0.2",
    "sharp": "^0.35.5",
    "typescript": "~5.6.3",
    "vite": "^5.4.10",
    "vitest": "^3.2.7"
  },
  "allowScripts": {
    "esbuild@0.21.5": true
  }
}
