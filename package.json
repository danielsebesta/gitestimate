{
  "name": "gitestimate",
  "private": true,
  "version": "0.1.0",
  "description": "Estimate how much time was spent building a GitHub repository from its commit history.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "measure": "vite-node scripts/measure.mts",
    "detect-debug": "vite-node scripts/detect-debug.mts"
  },

  "dependencies": {
    "@primer/octicons-react": "^19.9.0",
    "@primer/react": "^37.6.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "styled-components": "^5.3.10"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/styled-components": "^5.1.34",
    "@vitejs/plugin-react": "^4.3.3",
    "typescript": "~5.6.3",
    "vite": "^5.4.10",
    "vitest": "^3.2.7"
  },
  "allowScripts": {
    "esbuild@0.21.5": true
  }
}
